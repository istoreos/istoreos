-static bool proxy_rewrite_connection_close(struct client *cl, int header_end)
+static bool is_trusted_peer(struct uh_addr *addr)
+{
+	uint32_t a;
+
+	if (addr->family != AF_INET)
+		return false;
+
+	a = htonl(addr->in.s_addr);
+	return ((a >= 0x7F000000) && (a <= 0x7FFFFFFF)) ||
+	       ((a >= 0x0A000000) && (a <= 0x0AFFFFFF)) ||
+	       ((a >= 0xAC100000) && (a <= 0xAC1FFFFF)) ||
+	       ((a >= 0xC0A80000) && (a <= 0xC0A8FFFF));
+
+	return 0;
+}
+
+static bool proxy_rewrite_request_headers(struct client *cl, int header_end)
 {
 	static const char close_header[] = "Connection: close\r\n";
 	struct dispatch_proxy *p = &cl->dispatch.proxy;
 	const char *headers_end = p->initial + header_end - 2;
 	const char *line, *line_end;
 	const char *colon;
-	char *rewritten, *out;
-	size_t line_len, name_len, body_len;
-
-	if (proxy_request_is_websocket(p->initial, header_end))
-		return true;
+	char *rewritten, *out, *forwarded_headers;
+	size_t line_len, name_len, body_len, forwarded_len;
+	bool is_websocket;
+	bool trusted_peer;
+	bool skip;
+
+	is_websocket = proxy_request_is_websocket(p->initial, header_end);
+	trusted_peer = is_trusted_peer(&cl->peer_addr);
+	forwarded_headers = proxy_build_forwarded_headers(cl, p->initial,
+							  header_end,
+							  trusted_peer,
+							  &forwarded_len);
+	if (!forwarded_headers)
+		return false;
 
 	line_end = memmem(p->initial, header_end, "\r\n", 2);
-	if (!line_end)
+	if (!line_end) {
+		free(forwarded_headers);
 		return false;
+	}
 
-	rewritten = malloc(p->initial_len + sizeof(close_header));
-	if (!rewritten)
+	rewritten = malloc(p->initial_len + sizeof(close_header) + forwarded_len);
+	if (!rewritten) {
+		free(forwarded_headers);
 		return false;
+	}
 
 	out = rewritten;
 	memcpy(out, p->initial, line_end + 2 - p->initial);
@@ -316,16 +553,27 @@ static bool proxy_rewrite_connection_clo
 		line_end = memmem(line, headers_end - line, "\r\n", 2);
 		if (!line_end) {
 			free(rewritten);
+			free(forwarded_headers);
 			return false;
 		}
 
 		line_len = line_end - line;
 		colon = memchr(line, ':', line_len);
 		name_len = colon ? (size_t)(colon - line) : 0;
+		skip = false;
+
+		if (colon) {
+			if (!is_websocket &&
+			    (proxy_header_name_eq(line, name_len, "Connection") ||
+			     proxy_header_name_eq(line, name_len, "Proxy-Connection")))
+				skip = true;
+
+			if (!trusted_peer &&
+			    proxy_header_name_eq(line, name_len, "X-Forwarded-For"))
+				skip = true;
+		}
 
-		if (!colon ||
-		    (!proxy_header_name_eq(line, name_len, "Connection") &&
-		     !proxy_header_name_eq(line, name_len, "Proxy-Connection"))) {
+		if (!skip) {
 			memcpy(out, line, line_end + 2 - line);
 			out += line_end + 2 - line;
 		}
@@ -333,8 +581,15 @@ static bool proxy_rewrite_connection_clo
 		line = line_end + 2;
 	}
 
-	memcpy(out, close_header, sizeof(close_header) - 1);
-	out += sizeof(close_header) - 1;
+	memcpy(out, forwarded_headers, forwarded_len);
+	out += forwarded_len;
+	free(forwarded_headers);
+
+	if (!is_websocket) {
+		memcpy(out, close_header, sizeof(close_header) - 1);
+		out += sizeof(close_header) - 1;
+	}
+
 	memcpy(out, "\r\n", 2);
 	out += 2;
 
@@ -390,7 +645,7 @@ static bool proxy_append_initial(struct
 	p->header_complete = true;
 	ustream_set_read_blocked(cl->us, true);
 
-	if (!proxy_rewrite_connection_close(cl, header_end)) {
+	if (!proxy_rewrite_request_headers(cl, header_end)) {
 		proxy_error_response(cl, 502, "Bad Gateway");
 		return false;
 	}
