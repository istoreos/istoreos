From 7145e4f661f3167a6e613eecbdea4ce4bcc7ebe3 Mon Sep 17 00:00:00 2001
From: Yandong Lin <yandong.lin@rock-chips.com>
Date: Tue, 3 Jun 2025 17:20:30 +0800
Subject: [PATCH] iommu: rockchip: Fix map iova failed for third iommu

Change-Id: I0de9532371dcf4e592f69cd7d116f2af74391bb5
Signed-off-by: Yandong Lin <yandong.lin@rock-chips.com>
---
 drivers/iommu/rockchip-iommu.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

--- a/drivers/iommu/rockchip-iommu.c
+++ b/drivers/iommu/rockchip-iommu.c
@@ -832,9 +832,13 @@ static int rk_iommu_map(struct iommu_dom
 	u32 dte_index, pte_index;
 	int ret;
 
-	if (rk_domain->opt_ops && rk_domain->opt_ops->map)
-		return rk_domain->opt_ops->map(domain, _iova, paddr, size, prot,
-					       gfp, rk_domain->iommu_dev);
+	if (rk_domain->opt_ops && rk_domain->opt_ops->map) {
+		ret = rk_domain->opt_ops->map(domain, _iova, paddr, size, prot,
+					      gfp, rk_domain->iommu_dev);
+		if (!ret)
+			*mapped = size;
+		return ret;
+	}
 
 	spin_lock_irqsave(&rk_domain->dt_lock, flags);
 
